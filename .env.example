# =========================================================
# Required
# =========================================================

OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE


# =========================================================
# Optional: Tavily web search
# Used by the Turbo Agent for external research
# =========================================================

TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE


# =========================================================
# Optional: LangSmith tracing / observability
# =========================================================

LANGSMITH_API_KEY=YOUR_LANGSMITH_API_KEY_HERE
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=firmable-entities

# Optional for specific LangSmith workspace / region setups
# LANGSMITH_WORKSPACE_ID=YOUR_LANGSMITH_WORKSPACE_ID_HERE
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com